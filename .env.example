# Copy to `.env` (next to docker-compose.yml) to override the defaults.
# Defaults fit a laptop with Docker Desktop set to ~8 GB memory.
# The values below are a suggestion for a server with >= 16 GB RAM.

# Flink JobManager: JVM process size and container limit (limit > process size)
FLINK_JM_PROCESS_SIZE=2048m
FLINK_JM_MEM_LIMIT=2560m
FLINK_JM_CPUS=2

# Flink TaskManager: JVM process size and container limit (limit > process size)
FLINK_TM_PROCESS_SIZE=6144m
FLINK_TM_MEM_LIMIT=7168m
FLINK_TM_CPUS=4

# Kafka broker
KAFKA_HEAP_OPTS=-Xms1g -Xmx1g
KAFKA_MEM_LIMIT=2g

# Python services
CONSUMER_MEM_LIMIT=1g
LOAD_GENERATOR_MEM_LIMIT=1g

# --- Pipeline scaling (defaults: 1 partition, parallelism 1, 4 slots) ---
# Partitions of raw-/processed-/prink-topic (kafka-init; only ever increased)
# TOPIC_PARTITIONS=1
# Parallelism of the NEWS2 job (use <= TOPIC_PARTITIONS) and of the Prink job
# (keyed by patient; see og-prink/README.md "Parallelism")
# FLINK_JOB_PARALLELISM=1
# PRINK_PARALLELISM=1
# Task slots of the TaskManager (>= FLINK_JOB_PARALLELISM + PRINK_PARALLELISM)
# TASKMANAGER_SLOTS=4

# --- Kafka disk safety ---
# A partition is trimmed when older than the hours OR larger than the bytes
# limit (whichever comes first); deletion works on whole segments. Worst case:
#   3 topics x TOPIC_PARTITIONS x (KAFKA_LOG_RETENTION_BYTES + KAFKA_LOG_SEGMENT_BYTES)
# (+1 topic per Prink profile writing to its own topic).
# KAFKA_LOG_RETENTION_HOURS=6
# KAFKA_LOG_RETENTION_BYTES=3221225472   # per partition (3 GiB)
# KAFKA_LOG_SEGMENT_BYTES=268435456      # 256 MiB

# --- Load generator ---
# INPUT_DIR=output_json_files   # searched recursively: *.json, *.jsonl, *.jsonl.gz
# RESCAN_SECONDS=0              # > 0: pick up newly added patient files / units
# RATE_HZ=1
# REPLAY_MODE=fixed-rate        # or original-timing (measured_at) with SPEEDUP

# --- Scaling profile: ICU workload (~240 patients x 24 h at 1 Hz) on a VM with
# 16 vCPU / 32 GB RAM / ~50 GB free disk. Replaces the values above.
# Memory: JM 2.5 + TM 13 + Kafka 4 + Python 2 + Prometheus/Grafana 1 = ~23 GB.
# Disk:   3 topics x 4 partitions x (1 GiB + 256 MiB) = 15 GiB at most
#         (a day of all three topics is ~8-12 GB with lz4, so 24 h retention fits).
# FLINK_JM_PROCESS_SIZE=2048m
# FLINK_JM_MEM_LIMIT=2560m
# FLINK_TM_PROCESS_SIZE=12288m
# FLINK_TM_MEM_LIMIT=13312m
# FLINK_TM_CPUS=10
# TASKMANAGER_SLOTS=8
# TOPIC_PARTITIONS=4
# FLINK_JOB_PARALLELISM=2
# PRINK_PARALLELISM=1           # raise only if Prink cannot keep up (more information loss)
# KAFKA_HEAP_OPTS=-Xms2g -Xmx2g
# KAFKA_MEM_LIMIT=4g
# KAFKA_LOG_RETENTION_HOURS=24
# KAFKA_LOG_RETENTION_BYTES=1073741824
# KAFKA_LOG_SEGMENT_BYTES=268435456
# CONSUMER_MEM_LIMIT=1g
# LOAD_GENERATOR_MEM_LIMIT=512m
# RESCAN_SECONDS=60

# Program arguments for the Prink job, e.g. privacy parameters
# PRINK_JOB_ARGS=--k 5 --l 3 --delta 125 --beta 50000 --zeta 10000 --mu 100
# ICU record schema v2 with the bundled icu-qi-v2 profile, written to the topic the consumer reads
# (output_json_files_v2 is generated when the load-generator image is built; locally: make synthetic-v2):
# INPUT_DIR=output_json_files_v2
# PRINK_JOB_ARGS=--profile icu-qi-v2 --outputTopic prink-topic

# Salt for hashed (role: mask) profile fields such as userid/caseid in icu-qi-v2.
# Choose a long random value and keep it secret; never commit it.
# PRINK_MASK_SALT=

# Grafana admin password (default: admin)
# GRAFANA_ADMIN_PASSWORD=change-me
